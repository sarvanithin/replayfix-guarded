{
  "name": "replayfix-guarded",
  "version": "0.1.0",
  "private": true,
  "description": "A TrueForge-powered agent that turns session-replay evidence into tested, approval-gated draft pull requests.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sarvanithin/replayfix-guarded.git"
  },
  "bugs": {
    "url": "https://github.com/sarvanithin/replayfix-guarded/issues"
  },
  "homepage": "https://github.com/sarvanithin/replayfix-guarded#readme",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "analyze": "tsx src/cli/analyze.ts",
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "demo": "tsx src/cli/run.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "provision": "tsx src/cli/provision.ts",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "trueforge": "trueforge",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@truefoundry/trueforge-sdk": "0.1.4-rc.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@truefoundry/trueforge": "0.2.0-rc.0",
    "@types/node": "26.3.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^10.9.1",
    "prettier": "3.9.6",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
