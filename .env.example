# TrueForge SDK connection. Local mode does not require TRUEFORGE_TOKEN.
TRUEFORGE_BASE_URL=http://localhost:8790
TRUEFORGE_MODEL=openai/gpt-5-6-sol
TRUEFORGE_TOKEN=

# One-time server-side connector setup only. Use a fine-grained token scoped
# to the public demo repository. Never expose it to the browser or sandbox.
GITHUB_TOKEN=

# Required only when provisioning the Daytona sandbox provider.
DAYTONA_API_KEY=

# Commit SHA containing skills/replayfix-guarded/SKILL.md. Pin, never use main.
REPLAYFIX_SKILL_REF=

# Comma-separated exact owner/repository allowlist used by the demo workflow.
REPLAYFIX_ALLOWED_REPOSITORIES=sarvanithin/replayfix-guarded
